# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/buildforgestudio?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used during automatic seed if not created)
ADMIN_EMAIL=admin@buildforgestudio.com
ADMIN_PASSWORD=BuildForge@2026!Secure

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
FRONTEND_URL=https://buildforgestudio.vercel.app
